<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Flikk" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorControlNormal">@color/text</item>
        <item name="flikkAccent">@color/accent</item>
        <!-- Dialogs, menus: app laage black & white -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Flikk.Dialog</item>
        <item name="popupMenuStyle">@style/Flikk.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Flikk.PopupMenu</item>
        <item name="popupMenuBackground">@drawable/bg_popup</item>
        <item name="textAppearanceLargePopupMenu">@style/Flikk.PopupText</item>
        <item name="textAppearanceSmallPopupMenu">@style/Flikk.PopupText</item>
    </style>

    <style name="ThemeOverlay.Flikk.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#121212</item>
        <item name="colorSurfaceContainerHigh">#121212</item>
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#BDBDBD</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="alertDialogStyle">@style/Flikk.AlertDialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Flikk.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Flikk.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Flikk.DialogButton.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Flikk.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Flikk.DialogButton</item>
    </style>

    <style name="Flikk.AlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/Flikk.DialogShape</item>
        <item name="backgroundTint">#121212</item>
    </style>

    <style name="Flikk.DialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Flikk.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Flikk.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">#BDBDBD</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Flikk.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#BDBDBD</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Flikk.DialogButton.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>

    <style name="Flikk.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">10dp</item>
    </style>

    <style name="Flikk.PopupText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Theme.Flikk.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="PlayerIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@android:color/white</item>
    </style>

    <style name="Flikk.Tabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicatorColor">?attr/flikkAccent</item>
        <item name="tabSelectedTextColor">@color/text</item>
        <item name="tabTextColor">@color/muted</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabTextAppearance">@style/Flikk.TabText</item>
    </style>

    <style name="Flikk.TabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="SelectAction">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SelectActionText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PanelTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Flikk.Splash">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.Flikk.Music">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="QuickLink">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
