<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/sc_box"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/bg_thumb">

        <ImageView
            android:id="@+id/sc_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/sc_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_new_badge"
            android:paddingHorizontal="6dp"
            android:text="@string/new_badge"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sc_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/sc_track"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="#4DFFFFFF"
            android:visibility="gone" />

        <View
            android:id="@+id/sc_prog"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/sc_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="13sp" />
</LinearLayout>
