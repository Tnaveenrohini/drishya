<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Blurred album art background -->
    <ImageView
        android:id="@+id/bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/music_scrim" />

    <LinearLayout
        android:id="@+id/music_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: art · title / artist · search · queue · more -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#40000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="4dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/small_art"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/m_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/m_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="#CFCFCF"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/m_search"
                style="@style/PlayerIcon"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/m_queue_btn"
                style="@style/PlayerIcon"
                android:contentDescription="@string/queue"
                android:src="@drawable/ic_queue" />

            <ImageButton
                android:id="@+id/m_more"
                style="@style/PlayerIcon"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26FFFFFF" />

        <EditText
            android:id="@+id/m_search_box"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:hint="@string/search_songs"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9A9A9A"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Big cover: screen size ki taggattu square -->
            <LinearLayout
                android:id="@+id/cover_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="24dp"
                android:paddingBottom="12dp">

                <com.drishya.player.SquareFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/big_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_art"
                        android:contentDescription="@null"
                        android:elevation="12dp"
                        android:scaleType="centerCrop" />
                </com.drishya.player.SquareFrameLayout>

                <TextView
                    android:id="@+id/big_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/big_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#CFCFCF"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Queue -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/m_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="6dp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/m_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_music_pill"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="22dp"
            android:paddingVertical="10dp"
            android:textColor="#555555"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/m_pos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/m_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/m_timebar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            app:bar_height="4dp"
            app:buffered_color="#55FFFFFF"
            app:played_color="#FFFFFF"
            app:scrubber_color="#FFFFFF"
            app:scrubber_enabled_size="18dp"
            app:unplayed_color="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingBottom="14dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mode_shuffle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shuffle"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_prev"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_play"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_ring"
                android:contentDescription="@string/play_pause"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_repeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mode_all"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_repeat"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
