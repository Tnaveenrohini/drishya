<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Blurred album art background -->
    <ImageView
        android:id="@+id/bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/music_scrim" />

    <LinearLayout
        android:id="@+id/music_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: art · title / artist · search · queue · more -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/m_close"
                style="@style/PlayerIcon"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_chevron_down" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:text="@string/now_playing_caps"
                android:textColor="#A3A3A3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/small_art"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/m_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/m_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="#CFCFCF"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/m_search"
                style="@style/PlayerIcon"
                android:visibility="gone"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/m_queue_btn"
                style="@style/PlayerIcon"
                android:visibility="gone"
                android:contentDescription="@string/queue"
                android:src="@drawable/ic_queue" />

            <ImageButton
                android:id="@+id/m_more"
                style="@style/PlayerIcon"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <EditText
            android:id="@+id/m_search_box"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:hint="@string/search_songs"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9A9A9A"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Big cover: screen size ki taggattu square -->
            <LinearLayout
                android:id="@+id/cover_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="4dp">

                <com.drishya.player.SquareFrameLayout
                    android:id="@+id/vinyl_box"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/big_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_art"
                        android:contentDescription="@null"
                        android:elevation="12dp"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/vinyl_rings"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:elevation="12dp"
                        android:src="@drawable/bg_vinyl"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/vinyl_hole"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_vinyl_hole"
                        android:elevation="13dp"
                        android:visibility="gone" />
                </com.drishya.player.SquareFrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/big_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/big_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#A3A3A3"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/m_fav"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/favourites"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_favorite_border"
                        android:tint="#FFFFFF"
                        android:visibility="gone" />

                    <com.drishya.player.EqBarsView
                        android:id="@+id/m_eqbars"
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Queue -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/m_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="6dp"
                android:visibility="gone" />
        </FrameLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/m_timebar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginHorizontal="14dp"
            app:bar_height="4dp"
            app:buffered_color="#40FFFFFF"
            app:played_color="#FFFFFF"
            app:scrubber_color="#FFFFFF"
            app:scrubber_enabled_size="16dp"
            app:unplayed_color="#2EFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/m_pos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#A3A3A3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/m_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#A3A3A3"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mode_shuffle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shuffle"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_prev"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_play"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_play_white"
                android:contentDescription="@string/play_pause"
                android:elevation="6dp"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                android:tint="#000000" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/m_repeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mode_all"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_repeat"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- Bottom: Track / Queue segmented pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/m_seg_track"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_btn_white"
                android:gravity="center"
                android:text="@string/track"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/m_seg_queue"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/queue"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/m_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
