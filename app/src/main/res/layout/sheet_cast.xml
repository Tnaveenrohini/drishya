<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dot"
        android:alpha="0.35" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="8dp"
        android:text="@string/cast_to"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="8dp"
        android:text="@string/cast_devices_wifi"
        android:textColor="#A3A3A3"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/cast_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/cast_searching"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <ProgressBar
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/cast_searching"
            android:textColor="#BDBDBD"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cast_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/cast_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:max="1000"
            android:progressBackgroundTint="#40FFFFFF"
            android:progressTint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/cast_pos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#A3A3A3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cast_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A3A3A3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/cast_prev"
                style="@style/PlayerIcon"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_skip_prev" />

            <ImageButton
                android:id="@+id/cast_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="28dp"
                android:background="@drawable/bg_play_white"
                android:contentDescription="@string/play_pause"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                android:tint="#000000" />

            <ImageButton
                android:id="@+id/cast_next"
                style="@style/PlayerIcon"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
