<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="86dp">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumb"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_new_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="@string/new_badge"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/resume_bar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="?attr/flikkAccent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/video_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/video_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/item_more"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_more"
        android:tint="@color/muted" />

    <ImageView
        android:id="@+id/item_check"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_check_box_blank"
        android:visibility="gone" />
</LinearLayout>
