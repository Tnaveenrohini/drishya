<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- 360° videos -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view_360"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:show_buffering="when_playing"
        app:surface_type="spherical_gl_surface_view"
        app:use_controller="false" />

    <!-- ===== Controls overlay ===== -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/top_scrim"
            android:paddingBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/PlayerIcon"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/player_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_cast"
                style="@style/PlayerIcon"
                android:contentDescription="@string/fp_cast_to_tv"
                android:src="@drawable/ic_cast"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_pip"
                style="@style/PlayerIcon"
                android:contentDescription="@string/pip"
                android:src="@drawable/ic_pip" />

            <ImageButton
                android:id="@+id/btn_queue"
                style="@style/PlayerIcon"
                android:contentDescription="@string/playlist_title"
                android:src="@drawable/ic_queue" />

            <ImageButton
                android:id="@+id/btn_more"
                style="@style/PlayerIcon"
                android:contentDescription="@string/playback_settings"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_lock"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="28dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/lock"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lock_open"
            android:tint="@android:color/white" />

        <LinearLayout
            android:id="@+id/bottom_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_glass"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pos_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:text="0:00"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/time_bar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    app:ad_marker_color="#8A8A8A"
                    app:played_ad_marker_color="#8A8A8A"
                    app:ad_marker_width="4dp"
                    app:buffered_color="#55FFFFFF"
                    app:played_color="#FFFFFF"
                    app:scrubber_color="#FFFFFF"
                    app:unplayed_color="#33FFFFFF" />

                <TextView
                    android:id="@+id/dur_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="52dp"
                    android:text="0:00"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_rotate"
                    style="@style/PlayerIcon"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/rotate"
                    android:src="@drawable/ic_rotate" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <ImageButton
                    android:id="@+id/btn_fit"
                    style="@style/PlayerIcon"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="@string/fit"
                    android:src="@drawable/ic_fit" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_prev"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/previous"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_skip_prev"
                        android:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/btn_play"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginHorizontal="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/play_pause"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_pause"
                        android:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/btn_next"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/next"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@android:color/white" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_mute"
                    style="@style/PlayerIcon"
                    android:layout_gravity="end|center_vertical"
                    android:contentDescription="@string/mute"
                    android:src="@drawable/ic_volume" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Seek preview (scrub chesetappudu) -->
    <LinearLayout
        android:id="@+id/seek_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/seek_preview_img"
            android:layout_width="160dp"
            android:layout_height="90dp"
            android:background="#000000"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/seek_preview_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="3dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Brightness level (left) -->
    <FrameLayout
        android:id="@+id/level_left"
        android:layout_width="48dp"
        android:layout_height="200dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="40dp"
        android:background="@drawable/bg_level"
        android:padding="6dp"
        android:visibility="invisible">

        <View
            android:id="@+id/level_left_fill"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_level_fill" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_sun"
            android:tint="#000000" />

        <TextView
            android:id="@+id/level_left_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Volume level (right) -->
    <FrameLayout
        android:id="@+id/level_right"
        android:layout_width="48dp"
        android:layout_height="200dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_level"
        android:padding="6dp"
        android:visibility="invisible">

        <View
            android:id="@+id/level_right_fill"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_level_fill" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_volume"
            android:tint="#000000" />

        <TextView
            android:id="@+id/level_right_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hud"
        android:gravity="center"
        android:paddingHorizontal="22dp"
        android:paddingVertical="14dp"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Gesture lock -->
    <LinearLayout
        android:id="@+id/unlock_pill"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="22dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_accent_circle"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_lock"
            android:tint="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/unlock_hint"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Side panels ===== -->
    <View
        android:id="@+id/panel_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/panel_settings"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panel_settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/panel_queue"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"
            android:text="@string/playlist_title"
            android:textColor="#BBBBBB"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="#26FFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queue_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />
    </LinearLayout>
</FrameLayout>
